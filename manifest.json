{
  "manifest_version": 3,
  "name": "TabbyMcTabface",
  "version": "1.0.0",
  "description": "Passive-aggressive tab management with humor. Organizes your chaos while delivering snarky quips and clever easter eggs.",
  "author": "Phazzie",

  "permissions": [
    "tabs",
    "tabGroups",
    "notifications",
    "storage"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TabbyMcTabface - Tab Management with Attitude"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open TabbyMcTabface popup"
    },
    "feeling_lucky": {
      "description": "Close a random tab (I'm Feeling Lucky)"
    }
  }
}
