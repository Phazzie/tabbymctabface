{
  "name": "tabbymctabface",
  "version": "1.0.0",
  "private": true,
  "description": "A passive-aggressive Chrome tab manager powered by the Skeptical Wombat.",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration && npm run test:smoke",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:smoke && npm run test:e2e && npm run validate"
  },
  "keywords": [
    "chrome-extension",
    "tab-manager",
    "seam-driven-development",
    "skeptical-wombat"
  ],
  "author": "Phazzie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phazzie/tabbymctabface.git"
  },
  "homepage": "https://github.com/Phazzie/tabbymctabface#readme",
  "bugs": {
    "url": "https://github.com/Phazzie/tabbymctabface/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.9.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "fflate": "^0.8.3",
    "globals": "^17.11.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
