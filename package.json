{
  "name": "tabby",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "agent": "node sdd-agents/cli.js",
    "validate": "node sdd-agents/agents/documentation-validator.js",
    "scan-seams": "node sdd-agents/agents/seam-catalog-generator.js",
    "gen-contract": "node sdd-agents/agents/contract-generator.js",
    "gen-tests": "node sdd-agents/agents/test-generator.js",
    "analytics": "node sdd-agents/tools/pattern-analytics.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build": "npm run clean && npm run lint && npm run bundle && npm run copy-assets",
    "build:watch": "esbuild src/background.ts --bundle --format=esm --target=chrome110 --outfile=dist/background.js --watch & esbuild src/ui/popup.ts --bundle --format=iife --target=chrome110 --outfile=dist/popup.js --watch",
    "clean": "rm -rf dist",
    "copy-assets": "cp manifest.json popup.html popup.css dist/ && mkdir -p dist/icons && cp icons/*.png dist/icons/",
    "lint": "tsc --noEmit",
    "package": "npm run build && rm -f TabbyMcTabface.zip && cd dist && zip -r ../TabbyMcTabface.zip .",
    "dev": "npm run build:watch",
    "bundle": "esbuild src/background.ts --bundle --format=esm --target=chrome110 --outfile=dist/background.js && esbuild src/ui/popup.ts --bundle --format=iife --target=chrome110 --outfile=dist/popup.js"
  },
  "keywords": [
    "sdd",
    "seam-driven",
    "chrome-extension"
  ],
  "author": "",
  "license": "ISC",
  "description": "TabbyMcTabface - Seam-Driven Chrome Extension",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.14.0",
    "@vitest/ui": "^3.2.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
